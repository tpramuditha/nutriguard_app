
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/healthReports/{reportId} {

      function isOwner() {
        return request.auth != null
          && request.auth.uid == userId;
      }

      // Validate an individual laboratory measurement.
      function validMeasurement(m) {
        return m is map
          && m.keys().hasAll([
            'name',
            'value',
            'unit'
          ])
          && m.keys().hasOnly([
            'name',
            'value',
            'unit'
          ])
          && m.name is string
          && m.name.size() > 0
          && m.name.size() <= 100
          && m.value is number
          && m.value >= -1000000000
          && m.value <= 1000000000
          && m.unit is string
          && m.unit.size() > 0
          && m.unit.size() <= 40;
      }

      // Check every measurement in the supported list.
      function validMeasurements(items) {
        return items is list
          && items.size() > 0
          && items.size() <= 10
          && validMeasurement(items[0])
          && (items.size() < 2 || validMeasurement(items[1]))
          && (items.size() < 3 || validMeasurement(items[2]))
          && (items.size() < 4 || validMeasurement(items[3]))
          && (items.size() < 5 || validMeasurement(items[4]))
          && (items.size() < 6 || validMeasurement(items[5]))
          && (items.size() < 7 || validMeasurement(items[6]))
          && (items.size() < 8 || validMeasurement(items[7]))
          && (items.size() < 9 || validMeasurement(items[8]))
          && (items.size() < 10 || validMeasurement(items[9]));
      }

      function validReport() {
        let data = request.resource.data;

        return data.keys().hasAll([
            'reportType',
            'reportName',
            'reportDate',
            'measurements'
          ])
          && data.keys().hasOnly([
            'reportType',
            'reportName',
            'reportDate',
            'measurements'
          ])
          && data.reportType is string
          && data.reportType.size() > 0
          && data.reportType.size() <= 100
          && data.reportName is string
          && data.reportName.size() > 0
          && data.reportName.size() <= 150
          && data.reportDate is string
          && data.reportDate.size() > 0
          && data.reportDate.size() <= 40
          && validMeasurements(data.measurements);
      }

      // Authenticated owners can read their reports.
      allow read: if isOwner();

      // Owners can write only correctly structured reports.
      allow create, update: if isOwner() && validReport();

      // Only owners can delete their reports.
      allow delete: if isOwner();
    }

    
    // NutriGuard monthly health markers
    match /users/{userId}/monthlyHealthMarkers/{monthId} {

      function isMarkerOwner() {
        return request.auth != null
          && request.auth.uid == userId;
      }

      
function validMarkerMeasurement(m) {
  return m is map
    && m.keys().hasAll(['name', 'value', 'unit'])
    && m.keys().hasOnly(['name', 'value', 'unit'])
    && m.name is string
    && m.name.matches(
      '^(Total Cholesterol|LDL Cholesterol|HDL Cholesterol|Triglycerides|(Fasting|Random|After Meal) Blood Glucose|(Systolic|Diastolic) Blood Pressure)$'
    )
    && m.value is number
    && m.value > 0
    && m.value <= 1000000
    && m.unit is string
    && (
      (
        m.name.matches('^(Systolic|Diastolic) Blood Pressure$')
        && m.unit == 'mmHg'
      )
      ||
      (
        !m.name.matches('^(Systolic|Diastolic) Blood Pressure$')
        && m.unit == 'mg/dL'
      )
    );
}


      
      // Check whether a particular measurement name exists.
      function hasMarker(items, name) {
        return (items.size() > 0 && items[0].name == name)
          || (items.size() > 1 && items[1].name == name)
          || (items.size() > 2 && items[2].name == name)
          || (items.size() > 3 && items[3].name == name)
          || (items.size() > 4 && items[4].name == name)
          || (items.size() > 5 && items[5].name == name)
          || (items.size() > 6 && items[6].name == name);
      }

      // A measurement name must not appear twice.
      

function uniqueMarkerNames(items) {
  let names = [
    items[0].name,
    items.size() > 1 ? items[1].name : '__empty_1__',
    items.size() > 2 ? items[2].name : '__empty_2__',
    items.size() > 3 ? items[3].name : '__empty_3__',
    items.size() > 4 ? items[4].name : '__empty_4__',
    items.size() > 5 ? items[5].name : '__empty_5__',
    items.size() > 6 ? items[6].name : '__empty_6__'
  ];

  return names.toSet().size() == 7;
}



      // Systolic and diastolic must be recorded together.
      function validBloodPressurePair(items) {
        return hasMarker(items, 'Systolic Blood Pressure')
          == hasMarker(items, 'Diastolic Blood Pressure');
      }


      
      function validMarkerMeasurements(items) {
        return items is list
          && items.size() > 0
          && items.size() <= 7
          && validMarkerMeasurement(items[0])
          && (items.size() < 2 || validMarkerMeasurement(items[1]))
          && (items.size() < 3 || validMarkerMeasurement(items[2]))
          && (items.size() < 4 || validMarkerMeasurement(items[3]))
          && (items.size() < 5 || validMarkerMeasurement(items[4]))
          && (items.size() < 6 || validMarkerMeasurement(items[5]))
          && (items.size() < 7 || validMarkerMeasurement(items[6]))
          && uniqueMarkerNames(items)
          && validBloodPressurePair(items);
      }


      function validMonthlyMarkers() {
        let data = request.resource.data;

        return monthId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && data.keys().hasAll(['month', 'measurements'])
          && data.keys().hasOnly(['month', 'measurements'])
          && data.month is string
          && data.month == monthId
          && validMarkerMeasurements(data.measurements);
      }

      allow read: if isMarkerOwner();

      allow create, update: if isMarkerOwner()
        && validMonthlyMarkers();

      allow delete: if isMarkerOwner();
    }

  }
}
